FROM registry.fedoraproject.org/fedora:45

# Minimal Rust environment. Project packages are added per milestone
# (see spec/milestones/*/plan.md).
RUN dnf -y install gcc git sudo && dnf clean all

# Sandboxed decoding with glycin: loaders, bwrap, and the C libraries the
# glycin crate links.
RUN dnf -y install glycin-loaders bubblewrap glib2-devel fontconfig-devel \
        libseccomp-devel pkgconf-pkg-config && dnf clean all

# The JPEG encoder: mozjpeg's SIMD code needs nasm. Without it mozjpeg
# builds without SIMD and only warns; encode.rs has a test that fails then.
RUN dnf -y install nasm && dnf clean all

# Test fixtures (tests/fixtures/make.sh).
# avifenc makes real AVIF files; ImageMagick on Fedora cannot.
RUN dnf -y install ImageMagick perl-Image-ExifTool perl-IO-Compress libavif-tools \
        && dnf clean all

# HEVC for HEIC decode and the HEIC fixtures (decision 0001, option A).
# Stock Fedora has no HEVC codec; RPM Fusion free has libheif-freeworld.
# libheif-tools gives heif-enc and heif-info. The RPM Fusion key comes from
# Fedora's distribution-gpg-keys and must have the fingerprint published at
# https://rpmfusion.org/keys ("RPM Fusion free repository for Fedora
# (2020)", checked 2026-11-12); the release RPM must be signed with it.
ARG RPMFUSION_FREE_FPR=E9A491A3DE247814E7E067EAE06F8ECDD651FF2E
RUN set -eu; dnf -y install distribution-gpg-keys; \
    key=/usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-$(rpm -E %fedora); \
    fpr=$(gpg -q --show-keys --with-colons "$key" | awk -F: '$1 == "fpr" { print $10 }'); \
    [ "$fpr" = "$RPMFUSION_FREE_FPR" ] || { echo "RPM Fusion key fingerprint is '$fpr'" >&2; exit 1; }; \
    rpmkeys --import "$key"; \
    curl -fsSLo /tmp/rpmfusion-free-release.rpm \
        "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm"; \
    rpmkeys --checksig /tmp/rpmfusion-free-release.rpm | grep -q "signatures OK"; \
    dnf -y install /tmp/rpmfusion-free-release.rpm; rm /tmp/rpmfusion-free-release.rpm; \
    dnf -y install libheif-freeworld libheif-tools; dnf clean all

# GTK app and editor widget, headless UI tests (weston, D-Bus, AT-SPI) and
# data file validators (M2 plan, "Testing GTK headless").
RUN dnf -y install gtk4-devel libadwaita-devel weston dbus-daemon at-spi2-core \
        python3-pyatspi glib2-devel desktop-file-utils appstream \
        && dnf clean all

ARG USERNAME=dev
ARG USER_UID=1000
RUN useradd -m -u ${USER_UID} -s /bin/bash ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME}

USER ${USERNAME}
ENV PATH=/home/${USERNAME}/.cargo/bin:${PATH}
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
        --default-toolchain stable --component rustfmt,clippy
